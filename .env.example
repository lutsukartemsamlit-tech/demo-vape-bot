# ==============================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ==============================

# Токен бота — получить у @BotFather
BOT_TOKEN=your_bot_token_here

# Ваш Telegram ID — узнать у @userinfobot
ADMIN_ID=your_telegram_id_here

# ==============================
# НЕОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ==============================

# Несколько админов через запятую
# ADMIN_IDS=111111111,222222222

# URL вашего Mini App (после деплоя miniapp на Vercel)
WEBAPP_URL=https://your-miniapp.vercel.app

# Username канала для обязательной подписки (без @)
# Если не задано — проверка отключена
# REQUIRED_CHANNEL=your_channel

# Upstash Redis (для хранения данных)
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# PROXY_URL — НЕ НУЖЕН на Render (серверы в США, Telegram не заблокирован)
# Только для локального запуска в России:
# PROXY_URL=127.0.0.1:10809
